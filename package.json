{
  "name": "@telecmi/connle-video",
  "title": "Connle Video SDK for Web, Electron, and React Native",
  "version": "0.5.0",
  "description": "Official Connle video SDK for the browser \u2014 video/audio calls over LiveKit with Connle signalling.",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "keywords": [
    "webrtc",
    "video-call",
    "voice-call",
    "livekit",
    "react-native",
    "electron",
    "connle",
    "telecmi"
  ],
  "files": [
    "lib",
    "index.d.ts",
    "README.md",
    "README.web.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack serve --host 0.0.0.0 --mode development ",
    "build-node": "babel src --out-dir lib --extensions .js",
    "build:dev": "webpack --mode development",
    "test": "jest",
    "prepublishOnly": "npm run build-node && npm run build",
    "stage:native": "npm run build-node && node scripts/stage-native.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.25.6",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "babel-loader": "^9.2.1",
    "html-webpack-plugin": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "livekit-client": "^2.15.0",
    "socket.io-client": "^4.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telecmi/connle_video_js.git"
  },
  "homepage": "https://github.com/telecmi/connle_video_js#readme",
  "bugs": {
    "url": "https://github.com/telecmi/connle_video_js/issues"
  }
}
